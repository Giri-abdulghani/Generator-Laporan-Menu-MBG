</div></div></div></main>
<script>
const G=['Balita','Porsi Kecil','Porsi Besar','Bumil & Busui'];
const DAYS=['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
const MON=['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];
const LAB=[['Energi','kkal'],['Protein','g'],['Lemak','g'],['Karbohidrat','g'],['Serat','g']];
let S={date:'2026-11-13',menu:'Nasi Putih\nChicken Tsukune\nTahu Goreng\nTumis Brokoli Wortel\nPisang',
nut:[['590.25','18.89','23.86','75.16','2.66'],['590.25','18.89','23.86','75.16','2.66'],['680.25','20.39','24.01','95.06','2.76'],['770.25','21.89','24.16','114.96','2.86']]};
const TH=[['Hijau Segar','#14b36f','#066a45','#ffe27a','#d9a21b','#fff0a8','#0e9460','#05482f'],
['Biru Elektrik','#2272ff','#0a3fb8','#ffd84d','#e0a800','#ffec9a','#1a55d6','#0a2e8a'],
['Oranye Hangat','#ff8a1f','#d94a00','#fff1b8','#c26a00','#ffe08a','#ee7010','#8a2b00'],
['Merah Cerah','#e82a40','#9c0f24','#ffe07a','#d99a1a','#fff0a8','#c91e35','#6e0a18'],
['Pink Magenta','#e8399f','#8f1466','#ffe27a','#d99a1a','#fff0a8','#cc2a8a','#610a45'],
['Ungu Neon','#8040ff','#3d14b0','#ffd84d','#e0a800','#ffec9a','#6a34e6','#2a0c80'],
['Tosca Cerah','#10bdcc','#067a8a','#fff0a0','#d9a21b','#fff6c4','#0ea3b1','#045560'],
['Hijau Emas','#0f4f3d','#0a3529','#e0bb70','#b8893a','#f0d28f','#1b5a47','#0c3a2d'],
['Hitam Emas','#2a2c2f','#0e0f10','#e8c26b','#b8893a','#f3d896','#383b3f','#1a1b1d']];
let photo='',cur=0;
try{const x=JSON.parse(localStorage.getItem('mbg'));if(x&&x.nut)S=x}catch(e){}
const $=id=>document.getElementById(id);
if(S.name===undefined)S.name='SPPG Pahlawan 2';if(S.sub===undefined)S.sub='Program Makan Bergizi Gratis (MBG)';
const DEFLOGO=document.getElementById('pYys').src;
$('nm').value=S.name;$('sub').value=S.sub;
$('nm').oninput=e=>{S.name=e.target.value;draw()};$('sub').oninput=e=>{S.sub=e.target.value;draw()};
$('logoReset').onclick=()=>{S.logo='';draw()};
$('logo').onchange=e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{
 const w=Math.min(600,im.width),h=Math.round(im.height*w/im.width),c=document.createElement('canvas');c.width=w;c.height=h;const x=c.getContext('2d');
 x.fillStyle='#fff';x.fillRect(0,0,w,h);x.drawImage(im,0,0,w,h);const d=x.getImageData(0,0,w,h),a=d.data;
 for(let i=0;i<a.length;i+=4){const mn=Math.min(a[i],a[i+1],a[i+2]),mx=Math.max(a[i],a[i+1],a[i+2]);if(mn>200&&mx-mn<32){a[i]=a[i+1]=a[i+2]=255}}
 x.putImageData(d,0,0);S.logo=c.toDataURL('image/png');draw()};im.src=r.result};r.readAsDataURL(f)};
if(S.zoom===undefined){S.zoom=100;S.px=0;S.py=0;S.rad=56}
if(S.rot===undefined)S.rot=0;
const FIT=[['zm','zoom'],['px','px'],['py','py'],['rt','rot'],['rd','rad']];
FIT.forEach(([id,k])=>{$(id).value=S[k];$(id).oninput=e=>{S[k]=+e.target.value;draw()}});
$('fitReset').onclick=()=>{S.rot=0;S.zoom=100;S.px=0;S.py=0;S.rad=56;FIT.forEach(([id,k])=>$(id).value=S[k]);draw()};
let pickMode=false;const pv=$('pv'),cl=v=>Math.max(-60,Math.min(60,v));
function put(box){if(!photo){box.innerHTML=box===pv?'Belum ada foto':'Unggah foto menu';return}
 let im=box.querySelector('img');if(!im||im.dataset.s!==String(photo.length)){box.innerHTML='<img draggable="false">';im=box.firstChild;im.src=photo;im.dataset.s=photo.length}
 im.style.transform='translate('+S.px+'%,'+S.py+'%) rotate('+S.rot+'deg) scale('+S.zoom/100+')'}
function sync(){FIT.forEach(([id,k])=>$(id).value=S[k])}
function bind(el){let st=null;
 el.addEventListener('pointerdown',e=>{if(!photo||(el===pv&&pickMode))return;const r=el.getBoundingClientRect();st={x:e.clientX,y:e.clientY,w:r.width,h:r.height};el.setPointerCapture(e.pointerId)});
 el.addEventListener('pointermove',e=>{if(!st)return;S.px=cl(S.px+(e.clientX-st.x)/st.w*100);S.py=cl(S.py+(e.clientY-st.y)/st.h*100);st.x=e.clientX;st.y=e.clientY;sync();draw()});
 ['pointerup','pointercancel'].forEach(n=>el.addEventListener(n,()=>st=null));
 el.addEventListener('wheel',e=>{if(!photo)return;e.preventDefault();S.zoom=Math.min(300,Math.max(100,S.zoom-e.deltaY*.2));sync();draw()},{passive:false})}
let tgt='cb',hsv={h:210,s:1,v:1},lastHex='';
const h2r=(h,s,v)=>{const f=n=>{const k=(n+h/60)%6;return(v-v*s*Math.max(0,Math.min(k,4-k,1)))*255};return[f(5),f(3),f(1)]};
const r2h=c=>{const[r,g,b]=c.map(v=>v/255),M=Math.max(r,g,b),m=Math.min(r,g,b);return{h:hue(c),s:M?(M-m)/M:0,v:M}};
function pickUI(custom,h){const hex=(tgt==='ca'?(custom&&S.cacc?S.cacc:h[3]):tgt==='cb2'?(S.cb2||'#0a2e8a'):(custom?(S.cbase||'#2272ff'):h[1])).toLowerCase();
 if(hex!==lastHex){hsv=r2h(rg(hex));lastHex=hex}
 const hc=hx(h2r(hsv.h,1,1));
 $('sv').style.background='linear-gradient(to top,#000,transparent),linear-gradient(to right,#fff,'+hc+')';
 $('svh').style.left=hsv.s*100+'%';$('svh').style.top=(1-hsv.v)*100+'%';$('svh').style.background=hex;$('hh').style.left=hsv.h/360*100+'%';$('hh').style.background=hc;
 $('sw').style.background=hex;if(document.activeElement!==$('hex'))$('hex').value=hex.toUpperCase();
 [...$('tgt').children].forEach(b=>{b.classList.toggle('on',b.dataset.t===tgt);if(b.dataset.t==='cb2')b.style.display=S.grad?'':'none'});
 $('tSolid').classList.toggle('on',!S.grad);$('tGrad').classList.toggle('on',!!S.grad);$('gx').style.display=S.grad?'':'none';
 $('gt').value=S.gtype||'radial';$('ga').value=S.gang==null?160:S.gang}
function drag(el,fn){let on=false;const mv=e=>{const r=el.getBoundingClientRect();fn(Math.max(0,Math.min(1,(e.clientX-r.left)/r.width)),Math.max(0,Math.min(1,(e.clientY-r.top)/r.height)))};
 el.addEventListener('pointerdown',e=>{el.setPointerCapture(e.pointerId);on=true;mv(e)});el.addEventListener('pointermove',e=>{if(on)mv(e)});['pointerup','pointercancel'].forEach(n=>el.addEventListener(n,()=>on=false))}
function applyHSV(){const hex=hx(h2r(hsv.h,hsv.s,hsv.v)).toLowerCase();lastHex=hex;setColor(tgt,hex)}
