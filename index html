<style>
:root{--g1:#0f4f3d;--g2:#0a3529;--gold:#e0bb70;--gold2:#b8893a;--cream:#fbf3de;--ink:#0c3a2d;--gold3:#f0d28f;--tin:#1b5a47;--p1:#fbf4e0;--p2:#efe2c1}
*{box-sizing:border-box;margin:0}
body{font-family:Montserrat,system-ui,sans-serif;background:#16181a;color:#e8e8e8;display:flex;min-height:100vh}
aside{width:380px;padding:20px;background:#202427;overflow:auto;height:100vh;position:sticky;top:0}
